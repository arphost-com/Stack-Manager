# stack-manager.conf.example
# Copy to /etc/stack-manager.conf (system-wide) or ~/.config/stack-manager.conf (user)

# Root directory containing Docker Compose projects
ROOT="/docker"

# Marker file name for inactive projects
#INACTIVE_MARKER=".inactive"

# Enable/disable file logging (1=enabled, 0=disabled)
#LOG_ENABLED=1

# Log directory (default: same as ROOT)
#LOG_DIR="/var/log/stack-manager"

# Default timeout in seconds for pull/check operations (0=disabled)
#TIMEOUT_SECS=0

# Enable/disable hooks (1=enabled, 0=disabled)
#HOOKS_ENABLED=1

# Hooks directory (default: <ROOT>/.stack-manager/hooks)
#HOOKS_DIR="/docker/.stack-manager/hooks"

# Post-update cleanup (does not prune containers, networks, or volumes).
# Set to 0 or use --no-update-cleanup to disable.
#UPDATE_CLEANUP_ENABLED=1
# Minimum Docker image creation/cache age in hours (24..87600).
#UPDATE_CLEANUP_MIN_AGE_HOURS=168
